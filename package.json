{
  "name": "easy-typer",
  "version": "0.3.1",
  "description": "macOS平台可直接载文的跟打器",
  "author": "owenyang/木易",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "lint": "vue-cli-service lint",
    "dist": "electron-builder",
    "dmg": "npx electron-installer-dmg ./target/木易跟打器-darwin-x64/木易跟打器.app 木易跟打器",
    "pack": "electron-builder --dir",
    "package-mac": "npx electron-packager . 木易跟打器 --overwrite --platform=darwin --arch=x64 --out=target --icon=public/img/icons/logo-large.icns",
    "start": "electron .",
    "webpack-main": "webpack"
  },
  "main": "electron/main.js",
  "dependencies": {
    "@types/crypto-js": "^4.1.1",
    "@types/uuid": "^9.0.1",
    "applescript": "^1.0.0",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-plugin-pwa": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vue/cli-plugin-unit-jest": "~5.0.8",
    "@vue/cli-plugin-vuex": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/eslint-config-standard": "^8.0.1",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^1.0.3",
    "axios": "^0.21.1",
    "core-js": "^3.6.5",
    "dexie": "^3.0.3",
    "echarts": "^5.0.2",
    "electron": "^22.0.0",
    "electron-builder": "^23.6.0",
    "element-ui": "^2.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^8.7.1",
    "github-markdown-css": "^4.0.0",
    "heatmap.js": "^2.0.5",
    "lint-staged": "^13.3.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "process": "^0.11.10",
    "register-service-worker": "^1.7.1",
    "sass": "^1.69.5",
    "stream-browserify": "^3.0.0",
    "sass-loader": "^13.3.3",
    "showdown": "^1.9.1",
    "sitemap-webpack-plugin": "^1.1.1",
    "typescript": "~5.3.3",
    "vue": "^2.6.11",
    "vue-class-component": "^7.2.3",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.2.0",
    "vue-template-compiler": "^2.6.11",
    "vuex": "^3.4.0",
    "vuex-class": "^0.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.owenyang.easy-typer",
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "icon": "public/img/icons/logo-large.icns"
    },
    "productName": "木易跟打器",
    "copyright": "Copyright © 2023 ${author} build(20230118)",
    "asar": false
  },
  "pnpm": {
    "overrides": {
      "vue-template-compiler": "2.6.11"
    }
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "license": "ISC",
  "lint-staged": {
    "./src/*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint"
    ]
  }
}
